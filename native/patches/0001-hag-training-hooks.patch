+// HAG patch: single-sequence training/eval step (same graph/labels handling as opt_epoch_iter, no dataset).
+int32_t llama_context::opt_sequence(const llama_token * tokens, const llama_token * labels_sparse, bool train, ggml_opt_result_t result) {
+    GGML_ASSERT(opt_ctx);
+    const uint32_t n_ctx    = llama_model_n_ctx_train(&model);
+    const uint32_t n_batch  = std::min(this->n_batch(),  n_ctx);
+    const uint32_t n_ubatch = std::min(this->n_ubatch(), n_batch);
+    if (n_batch != n_ctx || n_ubatch != n_ctx) {
+        LLAMA_LOG_ERROR("%s: requires n_batch == n_ubatch == n_ctx\n", __func__);
+        return -1;
+    }
+
+    memory->clear(true);
+
+    llama_batch batch = llama_batch_init(n_batch, 0, 1);
+    int32_t ret = 0;
+    batch.n_tokens = n_batch;
+    for (uint32_t i = 0; i < n_batch; ++i) {
+        batch.token   [i]    = tokens[i];
+        batch.pos     [i]    = i;
+        batch.n_seq_id[i]    = 1;
+        batch.seq_id  [i][0] = 0;
+        batch.logits  [i]    = true;
+    }
+    do {
+        {
+            llama_batch_compat compat(this, batch);
+            if (!balloc->init(*compat.batch_ext, model.vocab, true)) {
+                LLAMA_LOG_ERROR("%s: failed to initialize batch\n", __func__);
+                ret = -2;
+                break;
+            }
+        }
+        const uint32_t n_tokens_all = balloc->get_n_tokens();
+        n_queued_tokens += n_tokens_all;
+        embd_seq.clear();
+        const uint32_t n_outputs_all = n_tokens_all;
+
+        auto mctx = memory->init_batch(*balloc, cparams.n_ubatch, true);
+        if (!mctx || mctx->get_status() != LLAMA_MEMORY_STATUS_SUCCESS) {
+            LLAMA_LOG_ERROR("%s: could not initialize batch\n", __func__);
+            ret = -3;
+            break;
+        }
+        if (output_reserve(n_outputs_all) < n_outputs_all) {
+            LLAMA_LOG_ERROR("%s: could not reserve space for %d outputs\n", __func__, n_outputs_all);
+            ret = -4;
+            break;
+        }
+        const auto & ubatch = mctx->get_ubatch();
+        n_outputs = ubatch.n_tokens;
+        if (!mctx->apply()) {
+            LLAMA_LOG_ERROR("%s: failed to update the memory context\n", __func__);
+            ret = -5;
+            break;
+        }
+
+        auto * res = get_gf_res_prev();
+        const auto gparams = graph_params(res, ubatch, mctx.get(), ctx_type_to_graph_type(cparams.ctx_type));
+        gf_res_prev_active = nullptr;
+        res->reset();
+        auto * gf = model.build_graph(gparams);
+
+        struct ggml_context * ctx_compute_opt;
+        {
+            const size_t size_gf = ggml_graph_size(gf);
+            const size_t size_meta = 4*size_gf*ggml_tensor_overhead() + 2*ggml_graph_overhead_custom(size_gf, /*grads = */ true);
+            struct ggml_init_params params = { size_meta, nullptr, true };
+            ctx_compute_opt = ggml_init(params);
+        }
+        ggml_opt_prepare_alloc(opt_ctx, ctx_compute_opt, gf, res->get_inp_tokens(), res->get_logits());
+        ggml_opt_alloc(opt_ctx, train);
+
+        res->set_inputs(&ubatch);
+        {
+            struct ggml_tensor * lt = ggml_opt_labels(opt_ctx);
+            GGML_ASSERT(lt->ne[1] == n_ubatch);
+            ggml_set_zero(lt);
+            const float onef = 1.0f;
+            for (uint32_t i = 0; i < n_ubatch; ++i) {
+                GGML_ASSERT(labels_sparse[i] >= 0 && labels_sparse[i] < lt->ne[0]);
+                ggml_backend_tensor_set(lt, &onef, (i*lt->ne[0] + labels_sparse[i])*sizeof(float), sizeof(float));
+            }
+        }
+        // opt_epoch_iter never applies the context's thread settings: ggml_opt_eval would run with the backend default
+        if (backend_cpu != nullptr) {
+            auto * reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend_cpu));
+            auto * set_threadpool_fn = (decltype(ggml_backend_cpu_set_threadpool) *) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool");
+            if (set_threadpool_fn) {
+                set_threadpool_fn(backend_cpu, threadpool_batch);
+            }
+        }
+        for (const auto & set_n_threads_fn : set_n_threads_fns) {
+            set_n_threads_fn.second(set_n_threads_fn.first, cparams.n_threads_batch);
+        }
+        ggml_opt_eval(opt_ctx, result);
+        ggml_free(ctx_compute_opt);
+    } while (false);
+    llama_batch_free(batch);
+    return ret;
+}
