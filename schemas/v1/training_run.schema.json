{
  "$defs": {
    "GateCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "default": "OK",
          "description": "Machine-readable reason code.",
          "title": "Code",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "conditional",
                "unverified"
              ],
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "requirement",
        "field",
        "value",
        "passed",
        "reason"
      ],
      "title": "GateCheck",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "attribution_required": {
          "enum": [
            "yes",
            "no",
            "conditional",
            "unverified"
          ],
          "title": "Attribution Required",
          "type": "string"
        },
        "blocking": {
          "items": {
            "type": "string"
          },
          "title": "Blocking",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/GateCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "entry_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Entry Hash",
          "type": "string"
        },
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "reason_codes": {
          "description": "Machine-readable codes for every blocking check.",
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "remediation": {
          "description": "What the owner must do to unblock.",
          "items": {
            "type": "string"
          },
          "title": "Remediation",
          "type": "array"
        },
        "requested_use": {
          "additionalProperties": true,
          "title": "Requested Use",
          "type": "object"
        },
        "restrictions": {
          "items": {
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "verification_state": {
          "default": "UNVERIFIED",
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "DISALLOWED"
          ],
          "title": "Verification State",
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "entry_hash",
        "requested_use",
        "allowed",
        "checks",
        "blocking",
        "attribution_required"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "ResourceEstimate": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "gpu_hours": {
          "title": "Gpu Hours",
          "type": "number"
        },
        "gpu_memory_gib": {
          "title": "Gpu Memory Gib",
          "type": "number"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "train_tokens": {
          "title": "Train Tokens",
          "type": "integer"
        },
        "trainable_params_m": {
          "title": "Trainable Params M",
          "type": "number"
        }
      },
      "required": [
        "basis",
        "trainable_params_m",
        "gpu_memory_gib",
        "train_tokens",
        "gpu_hours"
      ],
      "title": "ResourceEstimate",
      "type": "object"
    }
  },
  "$id": "https://hotatticgames.example/llmtrainer/schemas/v1/training_run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_model_id": {
      "title": "Base Model Id",
      "type": "string"
    },
    "base_model_license_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Base Model License Hash",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "dataset_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Dataset Hash",
      "type": "string"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "executor": {
      "enum": [
        "stub",
        "external"
      ],
      "title": "Executor",
      "type": "string"
    },
    "finished_on": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished On"
    },
    "hyperparameters": {
      "additionalProperties": true,
      "title": "Hyperparameters",
      "type": "object"
    },
    "is_pipeline_validation_stub": {
      "title": "Is Pipeline Validation Stub",
      "type": "boolean"
    },
    "kind": {
      "const": "training_run",
      "default": "training_run",
      "title": "Kind",
      "type": "string"
    },
    "license_gate": {
      "$ref": "#/$defs/GateResult"
    },
    "method": {
      "enum": [
        "stub",
        "lora",
        "qlora",
        "full"
      ],
      "title": "Method",
      "type": "string"
    },
    "output_artifacts": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Output Artifacts",
      "type": "object"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "resource_estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "source_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Manifest Hash",
      "type": "string"
    },
    "started_on": {
      "title": "Started On",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "planned"
      ],
      "title": "Status",
      "type": "string"
    },
    "train_metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Train Metrics",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "dataset_hash",
    "source_manifest_hash",
    "base_model_id",
    "base_model_license_hash",
    "license_gate",
    "method",
    "executor",
    "is_pipeline_validation_stub",
    "seed",
    "hyperparameters",
    "status",
    "started_on"
  ],
  "title": "TrainingRun",
  "type": "object",
  "x-schema-version": 1
}
