<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hag.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hag_bg</item>
        <item name="android:statusBarColor">@color/hag_bg</item>
        <item name="android:navigationBarColor">@color/hag_bg</item>
        <item name="android:windowSplashScreenBackground">@color/hag_bg</item>
        <!-- Invisible icon: suppress the default launcher-icon splash so ours is the first branded image. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
    </style>
</resources>
